[Unit]
Description=Hedioum Dynamic Pool Tunnel Daemon
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/etc/hedioum
# Privileged one-shot maintenance runs outside the long-running sandbox. Network
# tuning is idempotent and keeps Iran/foreign TCP/UDP ceilings symmetric after
# reboots; firewall opening remains foreign-only internally.
ExecStartPre=+/usr/local/bin/hedioum-tunnel --network-tune
ExecStartPre=+/usr/local/bin/hedioum-tunnel --open-firewall
ExecStart=/usr/local/bin/hedioum-tunnel
Restart=always
RestartSec=3
LimitNOFILE=1048576
TimeoutStopSec=30

# --- Sandbox hardening ---
CapabilityBoundingSet=CAP_NET_BIND_SERVICE{{if .TunCapable}} CAP_NET_ADMIN{{end}}
AmbientCapabilities=CAP_NET_BIND_SERVICE{{if .TunCapable}} CAP_NET_ADMIN{{end}}
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/hedioum
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
